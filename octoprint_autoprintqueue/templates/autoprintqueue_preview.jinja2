<div id="apq_preview" class="apq-preview">
    <div class="apq-preview-head" data-bind="visible: printItems().length">
        <button class="btn btn-mini" data-bind="click: previewPrev, enable: previewIndex() > 0" title="Previous job"><i class="fas fa-chevron-left"></i></button>
        <!-- ko with: previewItem -->
            <!-- ko if: thumbUrl -->
                <img class="apq-thumb apq-thumb-small" data-bind="attr: {src: thumbUrl}, event: {error: thumbError}" alt="">
            <!-- /ko -->
            <span class="apq-preview-title" data-bind="text: title, attr: {title: path}"></span>
            <span class="muted apq-preview-pos" data-bind="text: ($parent.previewIndex() + 1) + '/' + $parent.printItems().length"></span>
        <!-- /ko -->
        <button class="btn btn-mini" data-bind="click: previewNext, enable: previewIndex() < printItems().length - 1" title="Next job"><i class="fas fa-chevron-right"></i></button>
    </div>

    <div class="apq-preview-wrap">
        <canvas class="apq-preview-canvas" data-bind="apqFirstLayer: previewData"></canvas>
        <div class="apq-preview-overlay" data-bind="visible: previewMessage, text: previewMessage"></div>
    </div>

    <div class="apq-preview-info" data-bind="with: previewData">
        <span data-bind="text: $parent.previewSummary"></span>
        <!-- ko foreach: $parent.previewTools -->
            <span class="apq-tool-chip" data-bind="text: 'T' + tool, style: {background: color}"></span>
        <!-- /ko -->
    </div>

    <div class="apq-preview-mode" data-bind="visible: printItems().length">
        <span class="muted" data-bind="visible: !previewPinned()">Following the queue</span>
        <span data-bind="visible: previewPinned">
            <span class="muted">Pinned</span> ·
            <a href="#" data-bind="click: previewFollow">follow the queue</a>
        </span>
    </div>
</div>
